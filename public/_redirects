# Trailing-slash normalisation.
#
# Canonicals for non-root routes end in a slash (`/fyi/`) because that is what
# static hosts serve from `fyi/index.html`. Redirecting the slashless form here
# means a visitor (or crawler) never sees a redirect chain, and the URL they
# land on is exactly the one declared as canonical.
/fyi  /fyi/  301

# Never shadow a real file with the SPA shell.
/assets/*  /assets/:splat  200
/og/*      /og/:splat      200
/*.png     /:splat         200
/*.svg     /:splat         200
/*.xml     /:splat         200
/*.txt     /:splat         200
/*.webmanifest  /:splat    200
