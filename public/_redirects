# Trailing-slash normalisation for Cloudflare Pages / Netlify.
#
# Vercel reads vercel.json (`trailingSlash: true`) instead — keep the two files
# in agreement.
#
# Canonicals for non-root routes carry a trailing slash (`/fyi/`), because that
# is the path `fyi/index.html` is served under. Redirecting the slashless form
# here means the URL a visitor lands on is exactly the declared canonical.
/fyi  /fyi/  301

# Never shadow a real file with the SPA shell.
/assets/*  /assets/:splat  200
/og/*      /og/:splat      200
/*.png     /:splat         200
/*.svg     /:splat         200
/*.xml     /:splat         200
/*.txt     /:splat         200
/*.webmanifest  /:splat    200

# SPA shell for client-rendered routes that have no file of their own.
# /admin/ is one of them: it is reached by chord or direct URL and must still
# resolve. The rules above list the real files first, so none of them are
# shadowed by this catch-all.
/*        /index.html      200
