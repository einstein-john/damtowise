# FYI feature configuration
#
# Copy to `.env` (git-ignored) and fill in. These are inlined into the client
# bundle at build time, so a change means a rebuild — not a restart.

# Origin of the FYI API. Public reads and admin writes both go here; the API's
# CORS allow-list must include this site's origin.
VITE_FYI_API_URL=http://localhost:8787

# Origin of the Neon Auth (managed Better Auth) host. Used only by the admin
# console, to sign in and to mint the 15-minute bearer token the API verifies.
VITE_NEON_AUTH_URL=

# Analytics (existing site configuration)
VITE_PUBLIC_POSTHOG_TOKEN=
VITE_PUBLIC_POSTHOG_HOST=
